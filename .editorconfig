root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,yml,yaml,toml,css,html,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated fixtures are byte-exact; three-materials.obj has a material name with a trailing space on purpose.
[fixtures/**]
trim_trailing_whitespace = false
