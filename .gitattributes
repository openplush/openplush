# LF everywhere. Golden fixtures are compared byte-for-byte across platforms,
# so Windows checkouts must not convert line endings.
* text=auto eol=lf

# Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.glb binary
*.stl binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.wasm binary
